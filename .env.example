# Environment variables for Supabase
# Copy this file to .env.local and fill in your values

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Nodemailer — Gmail SMTP (para formulario de contacto landing)
# Usar App Password de Gmail (no la contraseña normal de la cuenta)
# Generar en: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
